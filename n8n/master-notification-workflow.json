      "name": "Send Event Reminder Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        1050,
        680
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const body = $input.first().json;\nconst studentEmail = (body.studentEmail || body.email || '').trim().toLowerCase();\nconst studentName = body.studentName || body.name || 'Student';\nconst certificateNumber = body.certificateNumber || body.certificateId || `TC-${Date.now()}`;\nconst eventName = body.eventName || body.eventTitle || 'Tech Club Event';\nconst isValidEmail = studentEmail.includes('@') && studentEmail.includes('.');\n\nreturn {\n  json: {\n    ...body,\n    studentEmail,\n    studentName,\n    certificateNumber,\n    eventName,\n    isValidEmail\n  }\n};"
      },
      "name": "Validate Certificate Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        900
      ]
    },
    {
      "parameters": {
