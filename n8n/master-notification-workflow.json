      },
      "name": "Check Confirmation Sent",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1050,
        420
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "return { json: { status: 'DUPLICATE_SKIPPED', message: 'Confirmation email already sent' } };"
      },
      "name": "Log Duplicate Registration Skipped",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        340
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const body = $input.first().json;\nreturn {\n  json: {\n    ...body,\n    eventId: body.eventId || 'event_123',\n    title: body.eventTitle || (body.event && body.event.title) || 'Tech Talk & Workshop',\n    date: body.eventDate || (body.event && body.event.date) || 'Upcoming',\n    time: body.eventTime || (body.event && body.event.time) || '10:00 AM',\n    venue: body.venue || (body.event && body.event.venue) || 'Tech Club Auditorium'\n  }\n};"
      },
      "name": "Fetch Event Document",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        500
      ]
    },
    {
      "parameters": {
        "fromEmail": "techclub@kalvium.community",
        "toEmail": "={{ $json.email }}",
        "subject": "=Registration Confirmed: {{ $json.title }} 🎟️",
        "html": "=<!DOCTYPE html><html><body><h2>Registration Confirmed for {{ $json.title }}</h2><p>Student Name: {{ $json.name }}</p><p>Date: {{ $json.date }}</p><p>Time: {{ $json.time }}</p><p>Venue: {{ $json.venue }}</p></body></html>",
        "options": {}
      },
      "name": "Send Registration Confirmation Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        1550,
        500
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "return { json: { registrationId: $input.first().json.registrationId, confirmationEmailSent: true, updatedAt: new Date().toISOString() } };"
      },
      "name": "Update Registration Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        500
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "return { json: { status: 'SUCCESS', type: 'EVENT_REGISTRATION', timestamp: new Date().toISOString() } };"
      },
      "name": "Update Log Success (Registration)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2050,
        500
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const body = $input.first().json;\nreturn {\n  json: {\n    ...body,\n    title: body.eventTitle || 'Upcoming Event',\n    email: body.email || body.studentEmail || 'student@kalvium.community',\n    name: body.studentName || body.name || 'Student'\n  }\n};"
      },
      "name": "Placeholder - REMINDER Branch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        680
      ]
    },
    {
      "parameters": {
        "fromEmail": "techclub@kalvium.community",
        "toEmail": "={{ $json.email }}",
        "subject": "=Reminder: {{ $json.title }} is starting soon! ⏰",
        "html": "=<!DOCTYPE html><html><body><h2>Reminder: {{ $json.title }}</h2><p>Hi {{ $json.name }}, your event is starting soon. See you there!</p></body></html>",
        "options": {}
