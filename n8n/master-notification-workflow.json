        "subject": "=Your Certificate for {{ $json.eventName }} 🎓",
        "html": "=<!DOCTYPE html><html><body><h2>Congratulations {{ $json.studentName }}!</h2><p>Your certificate for {{ $json.eventName }} is now ready.</p></body></html>",
        "options": {}
