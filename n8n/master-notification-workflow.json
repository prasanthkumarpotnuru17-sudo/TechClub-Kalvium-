{
  "name": "Master Notification Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "techclub/notifications",
        "options": {}
      },
      "name": "Master Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        500
      ],
      "webhookId": "master-notification-webhook-id"
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst rawType = (body.notificationType || body.type || 'UNKNOWN').toString().toUpperCase();\nlet normalizedType = 'UNKNOWN';\nif (rawType.includes('WELCOME')) normalizedType = 'WELCOME';\nelse if (rawType.includes('REGISTRATION')) normalizedType = 'EVENT_REGISTRATION';\nelse if (rawType.includes('REMINDER')) normalizedType = 'REMINDER';\nelse if (rawType.includes('CERTIFICATE')) normalizedType = 'CERTIFICATE';\nelse if (rawType.includes('ANNOUNCEMENT')) normalizedType = 'ANNOUNCEMENT';\nelse if (rawType.includes('ATTENDANCE')) normalizedType = 'ATTENDANCE';\nelse if (rawType.includes('CANCEL')) normalizedType = 'CANCELLATION';\n\nconst eventObj = body.event || {};\nconst eventTitle = body.eventTitle || eventObj.title || body.eventName || 'Tech Club Event';\nconst eventDate = body.eventDate || eventObj.date || eventObj.eventDate || body.date || 'Upcoming';\nconst eventTime = body.eventTime || eventObj.time || eventObj.eventTime || body.time || 'Scheduled Time';\nconst venue = body.venue || eventObj.venue || eventObj.location || body.location || 'Campus Auditorium';\nconst studentName = body.studentName || body.fullName || body.name || 'Student Participant';\nconst email = body.email || body.userEmail || body.studentEmail || '';\n\nreturn {\n  json: {\n    ...body,\n    notificationId: body.notificationId || body.correlationId || `notif-${Date.now()}`,\n    correlationId: body.correlationId || body.notificationId || `NTF-${Date.now()}`,\n    notificationType: normalizedType,\n    type: (body.type || normalizedType).toLowerCase(),\n    userId: body.userId || null,\n    registrationId: body.registrationId || null,\n    eventId: body.eventId || null,\n    eventTitle,\n    eventDate,\n    eventTime,\n    venue,\n    studentName,\n    email,\n    receivedAt: new Date().toISOString()\n  }\n};"
      },
      "name": "Standardize Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        500
      ]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.notificationType }}",
        "rules": {
          "rules": [
            {
              "value2": "WELCOME",
              "output": 0
            },
            {
              "value2": "EVENT_REGISTRATION",
              "output": 1
            },
            {
              "value2": "REMINDER",
              "output": 2
            },
            {
              "value2": "CERTIFICATE",
              "output": 3
            },
            {
              "value2": "ANNOUNCEMENT",
              "output": 4
            }
          ]
        },
        "fallbackOutput": 5
      },
      "name": "Route Notification Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        560,
        500
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const body = $input.first().json;\nreturn {\n  json: {\n    ...body,\n    userId: body.userId || 'user_default',\n    email: body.email || body.userEmail || 'student@kalvium.community',\n    displayName: body.name || body.fullName || body.studentName || 'Member',\n    welcomeEmailSent: body.welcomeEmailSent || false\n  }\n};"
      },
      "name": "Fetch User Document",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        150
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.welcomeEmailSent }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Check Welcome Sent",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1050,
        150
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "return { json: { status: 'DUPLICATE_SKIPPED', message: 'Welcome email already sent' } };"
      },
      "name": "Log Duplicate Welcome Skipped",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        60
      ]
    },
    {
      "parameters": {
        "fromEmail": "techclub@kalvium.community",
        "toEmail": "={{ $json.email }}",
        "subject": "Welcome to Kalvium Tech Club Platform! 🚀",
        "html": "=<!DOCTYPE html><html><body><h1>Welcome {{ $json.displayName }}!</h1><p>We are excited to have you in the Kalvium Tech Club community.</p></body></html>",
        "options": {}
      },
      "name": "Send Welcome Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        1300,
        220
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "return { json: { userId: $input.first().json.userId, welcomeEmailSent: true, updatedAt: new Date().toISOString() } };"
      },
      "name": "Update User Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1550,
        220
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "return { json: { status: 'SUCCESS', type: 'WELCOME', timestamp: new Date().toISOString() } };"
      },
      "name": "Update Log Success (Welcome)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        220
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const body = $input.first().json;\nreturn {\n  json: {\n    ...body,\n    registrationId: body.registrationId || `reg_${Date.now()}`,\n    email: body.email || body.studentEmail || 'student@kalvium.community',\n    name: body.studentName || body.name || 'Student',\n    confirmationEmailSent: body.confirmationEmailSent || false\n  }\n};"
      },
      "name": "Fetch Registration Document",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        420
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.confirmationEmailSent }}",
              "value2": true
            }
          ]
